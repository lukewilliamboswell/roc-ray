.{
    .name = .roc_ray,
    .version = "0.1.0",
    .minimum_zig_version = "0.16.0",
    // The host is self-contained: the Roc platform ABI is generated by
    // `roc glue` into src/roc_platform_abi.zig, so there is no Zig-package
    // dependency on the Roc compiler.
    .dependencies = .{
        .zio = .{
            .url = "git+https://github.com/lalinsky/zio?ref=v0.17.0#9711d68104946a457f151776000210d8adca3f3e",
            .hash = "zio-0.17.0-xHbVVI_jJQC3YbgU7JydwAV7MuASkOTd73YqBaKlFFUz",
        },
    },
    .fingerprint = 0x508f9eda9b4ae618,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "platform",
    },
}
