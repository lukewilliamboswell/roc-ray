          "frames": 20
        }
      ]
    },
    {
      "path": "examples/capture_plot",
      "cases": [
        {
          "name": "sweep",
          "frames": 20,
          "platforms": {
            "windows": {
              "run": false
            }
          },
          "reason": "Crashes with 0xC0000005 at startup on Windows; see issue #172"
        }
      ]
    },
